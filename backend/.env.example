# Copy this file to a local .env and replace placeholders with local development values.
# Do not commit .env or real credentials.
PORT=5000
DB_URL=mongodb://127.0.0.1:27017/lms
JWT_SECRET=replace-with-a-local-development-secret
# JWT_SECRET is canonical and required. Temporary migration only: if an existing local
# .env still uses JWT_Secret, explicitly set this to true, then rename the variable
# to JWT_SECRET and remove this flag.
# ALLOW_LEGACY_JWT_SECRET=true
JWT_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
# Keep this false unless a known reverse proxy or load balancer is correctly configured.
TRUST_PROXY=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_API_KEY=your-cloud-api-key
CLOUDINARY_CLOUD_API_SECRET=your-cloud-api-secret
# Server-only Cloudinary authentication token key. Never expose this to clients.
CLOUDINARY_AUTH_TOKEN_KEY=your-cloudinary-auth-token-key
# Cloudinary authentication token duration in seconds (60-3600; defaults to 600).
CLOUDINARY_AUTH_TOKEN_DURATION_SECONDS=600
# Cloudflare R2 is disabled by default. These values are server-only: never expose
# them to browser code or commit real credentials.
R2_ENABLED=false
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-private-r2-bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional; when unset the backend derives https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
R2_ENDPOINT=
# Short-lived GET URL duration in seconds (60-3600; defaults to 600 when R2 is enabled).
R2_SIGNED_URL_TTL_SECONDS=600
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-smtp-password
# Razorpay Test Mode credentials for local development only. Keep placeholders here;
# never commit real keys or copy a production secret into .env.example.
RAZORPAY_KEY_ID=your-test-mode-key-id
RAZORPAY_KEY_SECRET=your-test-mode-key-secret
RAZORPAY_PLAN_ID=your-razorpay-plan-id
