# Rename JWT_Secret to JWT_SECRET in your existing local .env outside of code changes.
PORT=5000
DB_URL=mongodb://127.0.0.1:27017/lms
JWT_SECRET=replace-with-a-local-development-secret
# Temporary migration only: if your local .env still uses JWT_Secret, set this to true, then rename it and remove this flag.
# ALLOW_LEGACY_JWT_SECRET=true
JWT_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_API_KEY=your-cloud-api-key
CLOUDINARY_CLOUD_API_SECRET=your-cloud-api-secret
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-smtp-password
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_PLAN_ID=your-razorpay-plan-id
