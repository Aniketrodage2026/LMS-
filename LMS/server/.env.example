# Copy this file to a local .env and replace placeholders with local development values.
# Do not commit .env or real credentials.
PORT=5000
DB_URL=mongodb://127.0.0.1:27017/lms
JWT_SECRET=replace-with-a-local-development-secret
# JWT_SECRET is canonical and required. Temporary migration only: if an existing local
# .env still uses JWT_Secret, explicitly set this to true, then rename the variable
# to JWT_SECRET and remove this flag.
# ALLOW_LEGACY_JWT_SECRET=true
JWT_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_API_KEY=your-cloud-api-key
CLOUDINARY_CLOUD_API_SECRET=your-cloud-api-secret
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-smtp-password
# Reserved for the next individual-course payment milestone. Use placeholders only;
# no real Razorpay credentials are committed to this repository.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_PLAN_ID=your-razorpay-plan-id
